--   HOME TAB
-- ============================================================

local activePlaceId = game.PlaceId
local activeGameId = game.GameId

local function containsManifestId(idList, value)
    if not idList then return false end
    local valueStr = tostring(value)
    for _, id in ipairs(idList) do
        if tostring(id) == valueStr then return true end
    end
    return false
end

local function isManifestCompatible(scriptInfo)
    if scriptInfo.universal == true or scriptInfo.gameId == 0 then return true end
    if scriptInfo.placeIds and containsManifestId(scriptInfo.placeIds, activePlaceId) then
        return true
    end
    if scriptInfo.gameIds and containsManifestId(scriptInfo.gameIds, activeGameId) then
        return true
    end
    return scriptInfo.gameId == activePlaceId or scriptInfo.gameId == activeGameId
end

local matchingScriptNames = {}
for _, scriptInfo in ipairs(SCRIPTS) do
    if isManifestCompatible(scriptInfo) then
        table.insert(matchingScriptNames,
            scriptInfo.name .. "  [" .. scriptInfo.version .. "]  |  " .. scriptInfo.description)
    end
end
if #matchingScriptNames == 0 then
    table.insert(matchingScriptNames, "No compatible module")
end

