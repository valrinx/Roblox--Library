local function getExperienceName()
    local fallback = tostring(game.Name or "Roblox Experience")

    -- A dungeon is a separate Place inside the same Roblox universe. Resolve
    -- the universe metadata first so Frozen Valley and the lobby share one
    -- config folder instead of being treated as separate games.
    local okUniverse, universeName = pcall(function()
        local universeId = tonumber(game.GameId)
        if not universeId or universeId <= 0 then
            return nil
        end
        local httpService = game:GetService("HttpService")
        local response = game:HttpGet(
            "https://games.roblox.com/v1/games?universeIds=" .. tostring(universeId)
        )
        local decoded = httpService:JSONDecode(response)
        local records = type(decoded) == "table" and decoded.data
        local first = type(records) == "table" and records[1]
        local name = first and first.name
        return type(name) == "string" and name ~= "" and name or nil
    end)
    if okUniverse and universeName then
        return universeName
    end

    local ok, info = pcall(function()
        return MarketplaceService:GetProductInfo(game.PlaceId)
    end)
    if ok and type(info) == "table" and type(info.Name) == "string" and info.Name ~= "" then
        return info.Name
    end
    return fallback
end

local EXPERIENCE_NAME = getExperienceName()

-- Experience names come from Roblox metadata and may contain characters that
-- are not valid in executor filesystem paths. Keep the readable name while
-- preventing accidental path traversal or invalid config folders.
local function sanitizeConfigSegment(value, fallback)
    local segment = tostring(value or fallback or "")
    -- Strip non-ASCII characters (like emojis and unicode symbols)
    segment = segment:gsub("[^\x20-\x7E]", "")
    -- Replace reserved filesystem characters and brackets with underscores
    segment = segment:gsub("[<>:\"/\\|?*%[%]%(%)]", "_")
    segment = segment:gsub("%s+", " ")
    segment = segment:gsub("^%s+", ""):gsub("%s+$", "")
    segment = segment:gsub("%.+$", "")
    if segment == "" or segment == "." or segment == ".." then
        segment = tostring(fallback or "Roblox Experience")
    end
    return segment
end

local function removeRetiredInterfaces()
    local roots = {}
    local seen = {}
    local function addRoot(root)
        if root and not seen[root] then
            seen[root] = true
            table.insert(roots, root)
        end
    end

    pcall(function()
        if type(gethui) == "function" then
            addRoot(gethui())
        end
    end)
    pcall(function()
        addRoot(game:GetService("CoreGui"))
    end)
    pcall(function()
        local localPlayer = Players.LocalPlayer
        addRoot(localPlayer and localPlayer:FindFirstChildOfClass("PlayerGui"))
    end)

    for _, root in ipairs(roots) do
        for _, child in ipairs(root:GetChildren()) do
            local isRetiredMacLib = false
            if child:IsA("ScreenGui")
                and child:FindFirstChild("Base")
                and child:FindFirstChild("Notifications") then
                for _, descendant in ipairs(child:GetDescendants()) do
                    if descendant:IsA("TextLabel") and descendant.Text == "RAVEN HUB" then
                        isRetiredMacLib = true
                        break
                    end
                end
            end
            if child.Name == "RavenUI" or child.Name == "RavenMacLib" or isRetiredMacLib then
                child:Destroy()
            end
        end
    end
end

removeRetiredInterfaces()

local function failBootstrap(message)
    local text = "RAVEN HUB failed: " .. tostring(message)
    warn(text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "RAVEN HUB - Startup error",
            Text = text:sub(1, 220),
            Duration = 12,
        })
    end)
    error(text, 0)
end

