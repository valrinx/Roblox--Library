        7633926880, -- BloxStrike
        7028566528, -- Basketball Zero
    }
    local curPlace = game.PlaceId
    local curGame = game.GameId
    for _, p in ipairs(bacPlaceIds) do
        if curPlace == p then return true end
    end
    for _, g in ipairs(bacGameIds) do
        if curGame == g then return true end
    end
    local rf = game:GetService("ReplicatedFirst")
    if rf and (rf:FindFirstChild("Sigma") or rf:FindFirstChild("Provider")) then
        return true
    end
    return false
end

