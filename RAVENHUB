local TELEPORT_LOADER = 'task.wait(2); loadstring(game:HttpGet("https://raw.githubusercontent.com/valrinx/Roblox--Library/refs/heads/main/RAVENHUB?v=teleport-persistence-1"))()'
local function armTeleportPersistence()
    local queue = queue_on_teleport or queueonteleport or (syn and syn.queue_on_teleport)
    if type(queue) ~= "function" then return false end
    local sessionKey = tostring(game.JobId) .. ":" .. tostring(game.PlaceId)
    if getgenv().__RAVEN_TELEPORT_QUEUE_SESSION == sessionKey then return true end
    local ok = pcall(queue, TELEPORT_LOADER)
    if ok then getgenv().__RAVEN_TELEPORT_QUEUE_SESSION = sessionKey end
    return ok
end
local TELEPORT_PERSISTENCE_ARMED = armTeleportPersistence()

local function getExperienceName()
    local fallback = tostring(game.Name or "Roblox Experience")
    local ok, info = pcall(function()
        return MarketplaceService:GetProductInfo(game.PlaceId)
    end)
    if ok and type(info) == "table" and type(info.Name) == "string" and info.Name ~= "" then
        return info.Name
    end
    return fallback
end

local EXPERIENCE_NAME = getExperienceName()

local function removeRetiredInterfaces()
    local roots = {}
    local seen = {}
    local function addRoot(root)
        if root and not seen[root] then
            seen[root] = true
            table.insert(roots, root)
        end
    end

    pcall(function()
        if type(gethui) == "function" then
            addRoot(gethui())
        end
    end)
    pcall(function()
        addRoot(game:GetService("CoreGui"))
    end)
    pcall(function()
        local localPlayer = Players.LocalPlayer
        addRoot(localPlayer and localPlayer:FindFirstChildOfClass("PlayerGui"))
    end)

    for _, root in ipairs(roots) do
        for _, child in ipairs(root:GetChildren()) do
            local isRetiredMacLib = false
            if child:IsA("ScreenGui")
                and child:FindFirstChild("Base")
                and child:FindFirstChild("Notifications") then
                for _, descendant in ipairs(child:GetDescendants()) do
                    if descendant:IsA("TextLabel") and descendant.Text == "RAVEN HUB" then
                        isRetiredMacLib = true
                        break
                    end
                end
            end
            if child.Name == "RavenUI" or child.Name == "RavenMacLib" or isRetiredMacLib then
                child:Destroy()
            end
        end
    end
end

removeRetiredInterfaces()

local function failBootstrap(message)
    local text = "RAVEN HUB failed: " .. tostring(message)
    warn(text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "RAVEN HUB - Startup error",
            Text = text:sub(1, 220),
            Duration = 12,
        })
    end)
    error(text, 0)
end

local MacLib
do
    local ok, result = pcall(function()
        local source = game:HttpGet("https://github.com/biggaboy212/Maclib/releases/latest/download/maclib.txt")
        assert(type(source) == "string" and #source > 1000, "MacLib download was empty")
        local chunk, compileError = loadstring(source)
        assert(chunk, "MacLib compile error: " .. tostring(compileError))
        local library = chunk()
        assert(type(library) == "table", "MacLib returned " .. type(library))
        return library
    end)
    if not ok then
        failBootstrap(result)
    end
    MacLib = result
end

local HubUI
do
    local ok, result = pcall(function()
        local source = game:HttpGet(
            "https://raw.githubusercontent.com/valrinx/Roblox--Library/main/modules/maclib_adapter.lua?v=maclib-adapter-1.1.0"
        )
        assert(type(source) == "string" and #source > 1000, "MacLib adapter download was empty")
        local chunk, compileError = loadstring(source)
        assert(chunk, "MacLib adapter compile error: " .. tostring(compileError))
        local factory = chunk()
        assert(type(factory) == "function", "MacLib adapter returned " .. type(factory))
        return factory(MacLib)
    end)
    if not ok then
        failBootstrap(result)
    end
    HubUI = result
end

local player    = Players.LocalPlayer
local character = player.Character
if not character then
    -- Some games (e.g. BRM5) use custom character systems without standard
    -- Roblox Characters. Wait briefly with timeout so the hub boots regardless.
    local done = false
    local conn; conn = player.CharacterAdded:Connect(function(c)
        character = c
        done = true
        if conn then conn:Disconnect() end
    end)
    local waited = 0
    while not done and waited < 5 do
        task.wait(0.5)
        waited = waited + 0.5
    end
    if conn then pcall(function() conn:Disconnect() end) end
end
