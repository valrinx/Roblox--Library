-- Build hub-owned tabs before dispatching any experience module.  A module
-- may yield while loading game services; keeping Settings on the loader's
-- original call stack prevents MacLib from losing its Plugin capability.
local scriptCleanupHandlers = {}
local HubSettingsTab = Window:CreateTab("Settings", 4483362458)

local cleanupFinished = false
local function cleanupHubScripts()
    if cleanupFinished then
        return
    end
    cleanupFinished = true
    for scriptName, cleanupFn in pairs(scriptCleanupHandlers) do
        local ok, err = pcall(cleanupFn)
        if not ok then
            warn("[RAVEN HUB] Cleanup failed for '" .. tostring(scriptName) .. "': " .. tostring(err))
        end
    end
end

Window:OnUnload(cleanupHubScripts)

HubSettingsTab:CreateButton({
    Name = "Destroy Hub",
    Callback = function()
        cleanupHubScripts()
        HubUI:Destroy()
    end,
})

HubSettingsTab:InsertConfigSection("Right")

-- ============================================================
--   LAZY LOAD
-- ============================================================

local currentPlaceId = game.PlaceId
local currentGameId  = game.GameId

local function containsId(idList, value)
    if not idList then return false end
    local valueStr = tostring(value)
    for _, id in ipairs(idList) do
        if tostring(id) == valueStr then
            return true
        end
    end
    return false
end

local function shouldLoadScript(scriptInfo)
    if scriptInfo.detector then
        local ok, matched = pcall(scriptInfo.detector)
        if ok and matched then
            return true
        end
    end

    if scriptInfo.universal == true then
        return true
    end

    if scriptInfo.placeIds and containsId(scriptInfo.placeIds, currentPlaceId) then
        return true
    end

    if scriptInfo.gameIds and containsId(scriptInfo.gameIds, currentGameId) then
        return true
    end

    -- backward compatibility for old schema
    if scriptInfo.gameId == 0 then
        return true
    end
    if scriptInfo.gameId == currentPlaceId or scriptInfo.gameId == currentGameId then
        return true
    end

    return false
end

-- map fingerprint fallback for cases where PlaceId/GameId differs across sub-places
for _, scriptInfo in ipairs(SCRIPTS) do
    if scriptInfo.name == "Ultimate Mining Tycoon" then
        scriptInfo.detector = function()
            return workspace:FindFirstChild("PlacedOre") ~= nil
                and workspace:FindFirstChild("SpawnedBlocks") ~= nil
        end
    elseif scriptInfo.name == "Wood Carving Tycoon" then
        scriptInfo.detector = function()
            local rs = game:GetService("ReplicatedStorage")
            return rs:FindFirstChild("Shared") ~= nil
                and rs.Shared:FindFirstChild("WoodCarving") ~= nil
        end
    end
end

local loadedScripts = {}

local function loadScriptModule(scriptInfo)
    if loadedScripts[scriptInfo.name] then return end
    loadedScripts[scriptInfo.name] = true
    scriptCleanupHandlers[scriptInfo.name] = nil
    setModuleStatus("Loading " .. scriptInfo.name .. "...")

    local ok, result = pcall(function()
        local sep = scriptInfo.moduleUrl:find("%?") and "&" or "?"
        local fetchUrl = scriptInfo.moduleUrl .. sep .. "_cb=" .. tostring(os.time()) .. "_" .. tostring(math.random(1000, 9999))
        local raw = game:HttpGet(fetchUrl)
        assert(type(raw) == "string" and #raw > 10,
            "HttpGet empty ?????????? URL: " .. scriptInfo.moduleUrl)

        local fn, compileErr = loadstring(raw)
        assert(fn, "loadstring error: " .. tostring(compileErr))

        local moduleFunc = fn()
        assert(type(moduleFunc) == "function",
            "module must return function, got: " .. type(moduleFunc))

        local runtimeInfo = table.clone(scriptInfo)
        runtimeInfo.hubRayfield = HubUI -- compatibility field for existing game modules
        runtimeInfo.hubUI = HubUI
        runtimeInfo.hubWindow = Window
        runtimeInfo.hubSettingsTab = HubSettingsTab
        runtimeInfo.registerCleanup = function(cleanupFn)
            if type(cleanupFn) == "function" then
                scriptCleanupHandlers[scriptInfo.name] = cleanupFn
            end
        end

        moduleFunc(Window, runtimeInfo)
    end)
    if not ok then
        loadedScripts[scriptInfo.name] = nil
        scriptCleanupHandlers[scriptInfo.name] = nil
        warn("[RAVEN HUB] Failed to load '" .. scriptInfo.name .. "': " .. tostring(result))
        setModuleStatus("FAILED - " .. scriptInfo.name .. ": " .. tostring(result))
        pcall(function()
            HubUI:Notify({
                Title = "RAVEN HUB - Module failed",
                Content = scriptInfo.name .. ": " .. tostring(result),
                Duration = 10,
            })
        end)
    else
        setModuleStatus("Loaded " .. scriptInfo.name)
    end
end

local matchedAnyScript = false
for _, scriptInfo in ipairs(SCRIPTS) do
    if shouldLoadScript(scriptInfo) then
        matchedAnyScript = true
        loadScriptModule(scriptInfo)
    elseif scriptInfo.detector then
        task.spawn(function()
            for _ = 1, 30 do
                task.wait(1)
                if shouldLoadScript(scriptInfo) then
                    loadScriptModule(scriptInfo)
                    return
                end
            end
        end)
    end
end

if not matchedAnyScript then
    setModuleStatus("No matching module for PlaceId " .. tostring(currentPlaceId)
        .. " / GameId " .. tostring(currentGameId))
    local unavailableMessage = "No compatible module is loaded for " .. tostring(game.Name) .. "."
    Window:CreatePlaceholderTab("Automation", "robot", unavailableMessage)
    Window:CreatePlaceholderTab("Visuals", "eye", unavailableMessage)
    Window:CreatePlaceholderTab("Movement", "walk", unavailableMessage)
end

