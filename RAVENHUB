if USE_DRAWING_UI then
    local ok, result = pcall(function()
        if type(readfile) == "function" then
            local okLocal, localSrc = pcall(readfile, "modules/drawing_ui.lua")
            if okLocal and type(localSrc) == "string" and #localSrc > 1000 then
                local chunk = loadstring(localSrc)
                if chunk then return chunk() end
            end
        end
        local source = game:HttpGet(
            "https://raw.githubusercontent.com/valrinx/Roblox--Library/main/modules/drawing_ui.lua?_cb=" .. tostring(os.time())
        )
        assert(type(source) == "string" and #source > 1000, "DrawingUI download was empty")
        local chunk, compileError = loadstring(source)
        assert(chunk, "DrawingUI compile error: " .. tostring(compileError))
        local library = chunk()
        assert(type(library) == "table", "DrawingUI returned " .. type(library))
        return library
    end)
    if ok then
        HubUI = result
        HUB_BUILD = "drawing-ghost-1.1"
    else
        if isBac then
            failBootstrap("100% Drawing API is strictly required for Anti-Cheat bypass in this game: " .. tostring(result))
        end
    end
end

if not HubUI and not isBac then
    -- Fallback to MacLib only for non-BAC games if Drawing API is unavailable
    HUB_BUILD = "maclib-5"
    local MacLib
    do
        local ok, result = pcall(function()
            local source = game:HttpGet("https://github.com/biggaboy212/Maclib/releases/latest/download/maclib.txt")
            assert(type(source) == "string" and #source > 1000, "MacLib download was empty")
            local chunk, compileError = loadstring(source)
            assert(chunk, "MacLib compile error: " .. tostring(compileError))
            local library = chunk()
            assert(type(library) == "table", "MacLib returned " .. type(library))
            return library
        end)
        if not ok then
            failBootstrap(result)
        end
        MacLib = result
    end

    do
        local ok, result = pcall(function()
            local source = game:HttpGet(
                "https://raw.githubusercontent.com/valrinx/Roblox--Library/main/modules/maclib_adapter.lua?v=maclib-adapter-1.1.7"
            )
            assert(type(source) == "string" and #source > 1000, "MacLib adapter download was empty")
            local chunk, compileError = loadstring(source)
            assert(chunk, "MacLib adapter compile error: " .. tostring(compileError))
            local factory = chunk()
            assert(type(factory) == "function", "MacLib adapter returned " .. type(factory))
            return factory(MacLib)
        end)
        if not ok then
            failBootstrap(result)
        end
        HubUI = result
    end
end

local player    = Players.LocalPlayer
local character = player.Character
if not character then
    -- Some games (e.g. BRM5) use custom character systems without standard
    -- Roblox Characters. Wait briefly with timeout so the hub boots regardless.
    local done = false
    local conn; conn = player.CharacterAdded:Connect(function(c)
        character = c
        done = true
        if conn then conn:Disconnect() end
    end)
    local waited = 0
    while not done and waited < 5 do
        task.wait(0.5)
        waited = waited + 0.5
    end
    if conn then pcall(function() conn:Disconnect() end) end
end
