-- ============================================================
-- UTIL
-- ============================================================
local function getPartFromInstance(inst)
    if inst:IsA("BasePart") then return inst end
    if inst:IsA("Model") and inst.PrimaryPart then return inst.PrimaryPart end
    return inst:FindFirstChildWhichIsA("BasePart", true)
end

local function readAttribs(inst)
    local a = {}
    a.tierNum     = inst:GetAttribute("Tier")
    a.tierName    = inst:GetAttribute("TierName")
    a.crystalName = inst:GetAttribute("CrystalName")
    a.value       = inst:GetAttribute("Value")
    a.weightKg    = inst:GetAttribute("WeightKg")
    a.sizeClass   = inst:GetAttribute("SizeClassName")
    a.luck        = inst:GetAttribute("LuckBoost") or inst:GetAttribute("Luck")
    local r = inst:GetAttribute("TierColorR")
    local g = inst:GetAttribute("TierColorG")
    local b = inst:GetAttribute("TierColorB")
    if r and g and b then a.tierColor = Color3.fromRGB(r,g,b) end
    return a
end

local function fmtValue(v)
    if not v then return nil end
    v = tonumber(v); if not v then return nil end
    -- แสดงตัวเลขเต็มพร้อม comma เหมือน map จริง
    local s = tostring(math.floor(v))
    -- ใส่ comma ทุก 3 หลัก
    local result = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
    result = result:gsub("^,", "")
    return "$" .. result
end

-- ============================================================
-- ESP CREATE
-- ============================================================
local function removeAllESP()
    for part, obj in pairs(espObjects) do
        if obj.bb and obj.bb.Parent then obj.bb:Destroy() end
        espObjects[part] = nil
    end
end

local function createESP(part, inst, isDropped)
    if not part or not inst then return end
    if espObjects[part] then return end

    local a = readAttribs(inst)
    local tierNum = a.tierNum or 0
    if tierNum < 1 or tierNum > 6 then return end
    if not CFG.SelectedTiers[tierNum] then return end
    if isDropped  and not CFG.ShowDropped then return end
    if not isDropped and not CFG.ShowMap  then return end

    local color    = a.tierColor or CFG.FallbackColors[tierNum] or Color3.new(1,1,1)
    local tag      = CFG.TierTags[tierNum]   or "?"
    local tierName = a.tierName or CFG.TierLabels[tierNum] or ("T"..tierNum)

    -- ===== BillboardGui =====
    local bb = Instance.new("BillboardGui")
    bb.Name        = "CrystalESP"
    bb.AlwaysOnTop = true
    bb.Size        = UDim2.new(0, 200, 0, 130)
    bb.StudsOffset = Vector3.new(0, 4, 0)
    bb.Adornee     = part
    bb.Parent      = CoreGui

    local yPos = 0
    local BLACK = Color3.new(0, 0, 0)

    local function makeLbl(text, txtColor, font, size, h)
        local lbl = Instance.new("TextLabel")
        lbl.Size                   = UDim2.new(1, 0, 0, h)
        lbl.Position               = UDim2.new(0, 0, 0, yPos)
        lbl.BackgroundTransparency = 1
        lbl.TextColor3             = txtColor
        lbl.TextStrokeTransparency = 0.25
        lbl.TextStrokeColor3       = BLACK
        lbl.Font                   = font
        lbl.TextSize               = size
        lbl.TextScaled             = false
        lbl.TextXAlignment         = Enum.TextXAlignment.Center
        lbl.Text                   = text
        lbl.Parent                 = bb
        yPos = yPos + h + 2
        return lbl
    end

    -- SizeClass tag: "Small"→"S", "Medium"→"M", "Large"→"L" ฯลฯ
    local sizeTag = a.sizeClass and a.sizeClass:sub(1,1):upper() or "?"

    -- Line 1: [L] Legendary — size tag + tier name กึ่งกลาง
    local hH = 30
    local hLbl = Instance.new("TextLabel")
    hLbl.Size                   = UDim2.new(1, 0, 0, hH)
    hLbl.Position               = UDim2.new(0, 0, 0, yPos)
    hLbl.BackgroundTransparency = 1
    hLbl.TextColor3             = color
    hLbl.TextStrokeTransparency = 0.2
    hLbl.TextStrokeColor3       = BLACK
    hLbl.Font                   = Enum.Font.GothamBold
    hLbl.RichText               = true
    hLbl.TextSize               = 26
    hLbl.TextScaled             = false
    hLbl.TextXAlignment         = Enum.TextXAlignment.Center
    hLbl.Text                   = string.format('<font color="#ffffff">[%s]</font> %s%s',
        sizeTag, tierName, isDropped and " 📦" or "")
    hLbl.Parent = bb
    yPos = yPos + hH + 1

    -- Line 2: weight (กึ่งกลาง, ขาว)
    if a.weightKg then
        makeLbl(string.format("%.1f kg", a.weightKg), Color3.fromRGB(230,230,230), Enum.Font.GothamBold, 16, 18)
    end

    -- Line 3: value เหลืองทอง
    local valStr = fmtValue(a.value)
    if valStr then
        makeLbl(valStr, Color3.fromRGB(255,215,0), Enum.Font.GothamBold, 22, 24)
    end

    -- Line 4: luck สีเหลืองอมส้ม
    if a.luck and tonumber(a.luck) and tonumber(a.luck) > 0 then
        makeLbl(
            string.format("Luck: +%.2f%%", tonumber(a.luck)),
            Color3.fromRGB(255,220,50),
            Enum.Font.GothamBold, 14, 16
        )
    end

    -- Line 5: distance เทาเล็ก อัปเดตทุก frame
    if CFG.ShowDist then
        local distLbl = Instance.new("TextLabel")
        distLbl.Name                   = "DistLabel"
        distLbl.Size                   = UDim2.new(1, 0, 0, 16)
        distLbl.Position               = UDim2.new(0, 0, 0, yPos)
        distLbl.BackgroundTransparency = 1
        distLbl.TextColor3             = Color3.fromRGB(160, 160, 180)
        distLbl.TextStrokeTransparency = 0.4
        distLbl.TextXAlignment         = Enum.TextXAlignment.Center
        distLbl.TextStrokeColor3       = Color3.new(0, 0, 0)
        distLbl.Font                   = Enum.Font.Gotham
        distLbl.TextSize               = 14
        distLbl.TextScaled             = false
        distLbl.Text                   = "..."
        distLbl.Parent                 = bb
    end

    -- resize bb height ให้พอดี content จริง
    bb.Size = UDim2.new(0, 200, 0, yPos + 18)

    espObjects[part] = { bb = bb, tierNum = tierNum }

    part.AncestryChanged:Connect(function()
        if not part:IsDescendantOf(game) then
            local obj = espObjects[part]
            if obj and obj.bb then obj.bb:Destroy() end
            espObjects[part] = nil
        end
    end)
end

-- ============================================================
-- SCAN / PROCESS
-- ============================================================
local function processCrystal(crystal, isDropped)
    if not crystal or not crystal.Parent then return end
    task.spawn(function()
        local attempts = 0
        while not crystal:GetAttribute("Tier") and attempts < 20 and crystal.Parent do
            task.wait(0.3); attempts += 1
        end
        if not crystal.Parent then return end
        local part = getPartFromInstance(crystal)
        if not part then return end
        if espObjects[part] then return end
        createESP(part, crystal, isDropped)
    end)
end

local function rescan()
    removeAllESP()
    task.wait()
    local dropped = workspace:FindFirstChild("DroppedCrystals")
    if dropped then
        for _, c in ipairs(dropped:GetChildren()) do processCrystal(c, true) end
    end
    local things = workspace:FindFirstChild("Things")
    local crs = things and things:FindFirstChild("Crystals")
    if crs then
        for _, c in ipairs(crs:GetChildren()) do processCrystal(c, false) end
    end
end

local function scanFolder(folder, isDropped)
    if scannedFolders[folder] then return end
    scannedFolders[folder] = true
    for _, c in ipairs(folder:GetChildren()) do processCrystal(c, isDropped) end
    folder.ChildAdded:Connect(function(c) processCrystal(c, isDropped) end)
end

-- ============================================================
-- HEARTBEAT
-- ============================================================
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    for part, obj in pairs(espObjects) do
        local bb = obj.bb
        if not bb or not bb.Parent then espObjects[part] = nil; continue end
        if not CFG.SelectedTiers[obj.tierNum] then
            bb:Destroy(); espObjects[part] = nil; continue
        end
        local ok, dist = pcall(function() return (part.Position - root.Position).Magnitude end)
        if not ok then bb:Destroy(); espObjects[part] = nil; continue end
        bb.Enabled = CFG.Enabled and dist <= CFG.MaxDistance
        if bb.Enabled then
            local dl = bb:FindFirstChild("DistLabel")
            if dl then
                dl.Visible = CFG.ShowDist
                dl.Text    = string.format("%.0f studs", dist)
            end
        end
    end
end)

task.spawn(function()
    local dropped = workspace:WaitForChild("DroppedCrystals", 15)
    if dropped then scanFolder(dropped, true) end
    local things = workspace:FindFirstChild("Things")
    local crs = things and things:FindFirstChild("Crystals")
    if crs then scanFolder(crs, false) end
end)

