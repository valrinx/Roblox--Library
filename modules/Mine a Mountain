makeSlider("Max Distance", 50, 800, function() return CFG.MaxDistance end, function(v) CFG.MaxDistance = v end)

-- จบ layout → ปรับ size Main ครั้งสุดท้าย
task.defer(updateMainSize)

-- Drag header
do
    local dragging, ds, sp
    Header.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; ds = i.Position; sp = Main.Position
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
            local d = i.Position - ds
            Main.Position = UDim2.new(sp.X.Scale, sp.X.Offset+d.X, sp.Y.Scale, sp.Y.Offset+d.Y)
        end
    end)
end

-- Minimize
local minimized = false
MinBtn.MouseButton1Click:Connect(function()
    minimized = not minimized
    if minimized then
        Main.ClipsDescendants = true
        TweenService:Create(Main, TweenInfo.new(0.18), { Size = UDim2.new(0, PANEL_W, 0, 40) }):Play()
    else
        TweenService:Create(Main, TweenInfo.new(0.18), {
            Size = UDim2.new(0, PANEL_W, 0, BodyList.AbsoluteContentSize.Y + 54)
        }):Play()
    end
    MinBtn.Text = minimized and "□" or "—"
end)

-- Close
CloseBtn.MouseButton1Click:Connect(function()
    TweenService:Create(Main, TweenInfo.new(0.18), { Size = UDim2.new(0, PANEL_W, 0, 0) }):Play()
    task.delay(0.2, function() ScreenGui:Destroy() end)
end)

-- RightShift toggle
UserInputService.InputBegan:Connect(function(i, gp)
    if gp then return end
    if i.KeyCode == Enum.KeyCode.RightShift then Main.Visible = not Main.Visible end
end)

print("[ESP v4] loaded | RightShift = toggle menu")