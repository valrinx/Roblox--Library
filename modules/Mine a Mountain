local function makeSlider(label, min, max, getValue, onChanged)
    local Row = Instance.new("Frame", Body)
    Row.Size             = UDim2.new(1, -16, 0, 52)
    Row.BackgroundColor3 = Color3.fromRGB(20, 20, 32)
    Row.BorderSizePixel  = 0
    Row.LayoutOrder      = nextLO()
    Instance.new("UICorner", Row).CornerRadius = UDim.new(0, 8)

    local Lbl = Instance.new("TextLabel", Row)
    Lbl.Size               = UDim2.new(0.65, 0, 0, 22)
    Lbl.Position           = UDim2.new(0, 10, 0, 4)
    Lbl.BackgroundTransparency = 1
    Lbl.TextColor3         = Color3.fromRGB(210, 210, 230)
    Lbl.TextSize           = 13
    Lbl.Font               = Enum.Font.Gotham
    Lbl.Text               = label
    Lbl.TextXAlignment     = Enum.TextXAlignment.Left

    local ValLbl = Instance.new("TextLabel", Row)
    ValLbl.Size               = UDim2.new(0.35, -10, 0, 22)
    ValLbl.Position           = UDim2.new(0.65, 0, 0, 4)
    ValLbl.BackgroundTransparency = 1
    ValLbl.TextColor3         = Color3.fromRGB(100, 160, 255)
    ValLbl.TextSize           = 13
    ValLbl.Font               = Enum.Font.GothamBold
    ValLbl.Text               = tostring(getValue())
    ValLbl.TextXAlignment     = Enum.TextXAlignment.Right

    local Track = Instance.new("Frame", Row)
    Track.Size             = UDim2.new(1, -20, 0, 6)
    Track.Position         = UDim2.new(0, 10, 0, 34)
    Track.BackgroundColor3 = Color3.fromRGB(35, 35, 55)
    Track.BorderSizePixel  = 0
    Instance.new("UICorner", Track).CornerRadius = UDim.new(1, 0)

    local t0 = (getValue() - min) / (max - min)
    local Fill = Instance.new("Frame", Track)
    Fill.Size             = UDim2.new(t0, 0, 1, 0)
    Fill.BackgroundColor3 = Color3.fromRGB(70, 120, 255)
    Fill.BorderSizePixel  = 0
    Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)

    local Handle = Instance.new("Frame", Track)
    Handle.Size             = UDim2.new(0, 14, 0, 14)
    Handle.AnchorPoint      = Vector2.new(0.5, 0.5)
    Handle.Position         = UDim2.new(t0, 0, 0.5, 0)
    Handle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Handle.BorderSizePixel  = 0
    Instance.new("UICorner", Handle).CornerRadius = UDim.new(1, 0)

    local dragging = false
    local function update(x)
        local abs = Track.AbsolutePosition.X
        local w   = Track.AbsoluteSize.X
        local t   = math.clamp((x - abs) / w, 0, 1)
        local val = math.floor(min + t * (max - min))
        Fill.Size       = UDim2.new(t, 0, 1, 0)
        Handle.Position = UDim2.new(t, 0, 0.5, 0)
        ValLbl.Text     = tostring(val)
        onChanged(val)
    end

    local SBtn = Instance.new("TextButton", Track)
    SBtn.Size = UDim2.new(1, 0, 4, 0); SBtn.Position = UDim2.new(0, 0, -1.5, 0)
    SBtn.BackgroundTransparency = 1; SBtn.Text = ""
    SBtn.MouseButton1Down:Connect(function()
        dragging = true; update(UserInputService:GetMouseLocation().X)
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
            update(i.Position.X)
        end
    end)
end

-- Tier filter
local function makeTierFilter()
    local Row = Instance.new("Frame", Body)
    Row.Size             = UDim2.new(1, -16, 0, 84)
    Row.BackgroundColor3 = Color3.fromRGB(20, 20, 32)
    Row.BorderSizePixel  = 0
    Row.LayoutOrder      = nextLO()
    Instance.new("UICorner", Row).CornerRadius = UDim.new(0, 8)

    local Lbl = Instance.new("TextLabel", Row)
    Lbl.Size               = UDim2.new(1, 0, 0, 20)
    Lbl.Position           = UDim2.new(0, 10, 0, 4)
    Lbl.BackgroundTransparency = 1
    Lbl.TextColor3         = Color3.fromRGB(210, 210, 230)
    Lbl.TextSize           = 12
    Lbl.Font               = Enum.Font.Gotham
    Lbl.Text               = "Tier Filter"
    Lbl.TextXAlignment     = Enum.TextXAlignment.Left

    local tierColors = {
        Color3.fromRGB(155,155,155),
        Color3.fromRGB(70,185,70),
        Color3.fromRGB(70,120,255),
        Color3.fromRGB(160,70,255),
        Color3.fromRGB(255,185,25),
        Color3.fromRGB(255,70,180),
    }
    local btns = {}
    local function refreshBtns()
        for i, b in ipairs(btns) do
            local on = CFG.SelectedTiers[i]
            b.BackgroundColor3 = on and tierColors[i] or Color3.fromRGB(30,30,48)
            b.TextColor3       = on and Color3.new(1,1,1) or Color3.fromRGB(120,120,150)
        end
    end
    for i = 1, 6 do
        local col = (i-1) % 3
        local row = math.floor((i-1)/3)
        local Btn = Instance.new("TextButton", Row)
        Btn.Size             = UDim2.new(0, 38, 0, 22)
        Btn.Position         = UDim2.new(0, 8 + col*48, 0, 28 + row*30)
        Btn.BorderSizePixel  = 0
        Btn.TextSize         = 11
        Btn.Font             = Enum.Font.GothamBold
        Btn.Text             = "T"..i
        Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 5)
        btns[i] = Btn
        Btn.MouseButton1Click:Connect(function()
            if CFG.SelectedTiers[i] then CFG.SelectedTiers[i] = nil
            else CFG.SelectedTiers[i] = true end
            refreshBtns(); rescan()
        end)
    end
    refreshBtns()
end

